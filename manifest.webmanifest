{
  "name": "Sketchboard",
  "short_name": "Sketchboard",
  "description": "A free, private, hand-drawn whiteboard. Sketch boxes, connect them with arrows, color them and save.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#6965db",
  "categories": ["productivity", "graphics", "education"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/json": [".excalidraw"] } }
  ]
}
